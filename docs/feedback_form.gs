/**
 * Создаёт анонимную Google-форму обратной связи по приложению MassLab
 * и таблицу Google Sheets, куда будут попадать ответы.
 *
 * Как запустить:
 *   1. Откройте https://script.google.com и нажмите «Новый проект».
 *   2. Удалите текст в редакторе и вставьте весь этот файл.
 *   3. Нажмите «Выполнить» (функция createMassLabForm) и разрешите доступ
 *      к Google Формам и Таблицам.
 *   4. Откройте «Журнал выполнения»: там будут ссылки на форму (для студентов),
 *      на редактирование формы и на таблицу с ответами.
 *   5. Короткую ссылку для студентов вставьте в masslab/config.py →
 *      FEEDBACK_FORM_URL — её QR-код появится на итоговом экране.
 */

var AGREE = ['Совсем не согласен', 'Скорее не согласен', 'Затрудняюсь ответить',
             'Скорее согласен', 'Полностью согласен'];

function createMassLabForm() {
  var form = FormApp.create('MassLab — отзыв о виртуальной лабораторной работе');
  form.setDescription(
    'Спасибо, что выполнили лабораторную работу «Времяпролётный масс-спектрометр»! ' +
    'Анкета анонимная и займёт 5–7 минут. Ответы помогут улучшить приложение ' +
    'и используются только в обобщённом виде в выпускной работе.');
  form.setCollectEmail(false);
  form.setProgressBar(true);
  form.setShowLinkToRespondAgain(false);
  form.setConfirmationMessage('Спасибо! Ваш ответ записан.');

  // --- 1. Общие сведения ------------------------------------------------
  form.addSectionHeaderItem().setTitle('1. Общие сведения');

  form.addMultipleChoiceItem()
      .setTitle('Как вы выполняли работу?')
      .setChoiceValues(['В паре, управлял(а) приложением я',
                        'В паре, управлял(а) напарник',
                        'Один (одна)'])
      .setRequired(true);

  form.addMultipleChoiceItem()
      .setTitle('Работали ли вы раньше с виртуальными лабораторными работами?')
      .setChoiceValues(['Да, часто', 'Да, несколько раз', 'Нет, впервые'])
      .setRequired(true);

  form.addMultipleChoiceItem()
      .setTitle('Удалось ли выполнить все задания за пару?')
      .setChoiceValues(['Да, осталось свободное время', 'Да, впритык',
                        'Нет, не хватило времени'])
      .setRequired(true);

  // --- 2. Понимание темы (до и после) -------------------------------------
  form.addPageBreakItem().setTitle('2. Понимание темы');

  form.addScaleItem()
      .setTitle('Насколько хорошо вы понимали принцип работы времяпролётного ' +
                'масс-спектрометра ДО этой работы?')
      .setBounds(1, 5).setLabels('Совсем не понимал(а)', 'Понимал(а) отлично')
      .setRequired(true);

  form.addScaleItem()
      .setTitle('Насколько хорошо вы понимаете его ПОСЛЕ этой работы?')
      .setBounds(1, 5).setLabels('Совсем не понимаю', 'Понимаю отлично')
      .setRequired(true);

  form.addMultipleChoiceItem()
      .setTitle('Проверьте себя: как изменится время пролёта иона, если ускоряющее ' +
                'напряжение увеличить в 4 раза?')
      .setChoiceValues(['Уменьшится в 2 раза', 'Уменьшится в 4 раза',
                        'Увеличится в 2 раза', 'Не изменится', 'Не знаю'])
      .setRequired(true);

  form.addMultipleChoiceItem()
      .setTitle('Проверьте себя: почему один элемент может дать в спектре несколько ' +
                'пиков рядом?')
      .setChoiceValues(['У него несколько изотопов', 'Ионы ускорялись разным напряжением',
                        'Это шум детектора', 'Это остаточный газ', 'Не знаю'])
      .setRequired(true);

  // --- 3. Оценка этапов ---------------------------------------------------
  form.addPageBreakItem().setTitle('3. Этапы работы');

  form.addGridItem()
      .setTitle('Оцените сложность каждого этапа')
      .setRows(['Входной тест', 'Задание 1. Запуск ионов',
                'Задание 2. Неизвестный элемент', 'Задание 3. Состав сплава',
                'Защита работы'])
      .setColumns(['Очень легко', 'Легко', 'В самый раз', 'Сложно', 'Очень сложно'])
      .setRequired(true);

  form.addGridItem()
      .setTitle('Насколько интересным был каждый этап?')
      .setRows(['Входной тест', 'Задание 1. Запуск ионов',
                'Задание 2. Неизвестный элемент', 'Задание 3. Состав сплава',
                'Защита работы'])
      .setColumns(['Скучно', 'Скорее скучно', 'Нормально', 'Интересно', 'Очень интересно'])
      .setRequired(true);

  form.addCheckboxItem()
      .setTitle('Что помогало вам при выполнении работы? (можно выбрать несколько)')
      .setChoiceValues(['Тур-подсказки при входе в задание', 'Методичка',
                        'Подсказки после ошибок', 'Измерение пика наведением курсора',
                        'Сравнение двух пиков щелчком', 'Справочник элементов',
                        'Схема прибора и траектории', 'Помощь преподавателя',
                        'Помощь напарника'])
      .showOtherOption(true);

  // --- 4. Удобство (SUS) --------------------------------------------------
  form.addPageBreakItem()
      .setTitle('4. Удобство приложения')
      .setHelpText('Стандартный опросник удобства System Usability Scale (SUS). ' +
                   'Отметьте, насколько вы согласны с каждым утверждением.');

  form.addGridItem()
      .setTitle('Насколько вы согласны с утверждениями?')
      .setRows([
        '1. Я бы хотел(а) пользоваться этим приложением и на других занятиях',
        '2. Приложение неоправданно сложное',
        '3. Приложением легко пользоваться',
        '4. Мне нужна была бы помощь, чтобы пользоваться приложением',
        '5. Разные функции приложения хорошо связаны между собой',
        '6. В приложении много несогласованности',
        '7. Большинство студентов быстро научатся пользоваться приложением',
        '8. Приложение очень неудобное',
        '9. Я чувствовал(а) себя уверенно, работая с приложением',
        '10. Мне пришлось многое узнать, прежде чем начать работу'])
      .setColumns(AGREE)
      .setRequired(true);

  form.addScaleItem()
      .setTitle('Насколько вероятно, что вы порекомендуете эту работу студентам ' +
                'следующего курса?')
      .setBounds(0, 10).setLabels('Точно нет', 'Обязательно')
      .setRequired(true);

  // --- 5. Технические вопросы ---------------------------------------------
  form.addPageBreakItem().setTitle('5. Техническая сторона');

  form.addMultipleChoiceItem()
      .setTitle('Были ли технические проблемы?')
      .setChoiceValues(['Нет', 'Да, мелкие (не мешали работе)',
                        'Да, серьёзные (мешали работе)'])
      .setRequired(true);

  form.addParagraphTextItem()
      .setTitle('Если были проблемы — опишите, что произошло')
      .setHelpText('Например: «не запускались ионы», «текст не помещался на экране».');

  form.addMultipleChoiceItem()
      .setTitle('Какую тему оформления вы использовали?')
      .setChoiceValues(['Тёмную', 'Светлую', 'Переключал(а) обе', 'Не заметил(а) переключатель']);

  // --- 6. Свободные ответы -------------------------------------------------
  form.addPageBreakItem().setTitle('6. Ваше мнение');

  form.addParagraphTextItem().setTitle('Что вам больше всего понравилось?');
  form.addParagraphTextItem().setTitle('Что было непонятно или неудобно?');
  form.addParagraphTextItem().setTitle('Что бы вы добавили или изменили в приложении?');

  // --- Таблица ответов и ссылки ---------------------------------------------
  var sheet = SpreadsheetApp.create('MassLab — ответы на анкету');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());

  var url = form.getPublishedUrl();
  Logger.log('Ссылка для студентов:   ' + form.shortenFormUrl(url));
  Logger.log('Полная ссылка:          ' + url);
  Logger.log('Редактирование формы:   ' + form.getEditUrl());
  Logger.log('Таблица с ответами:     ' + sheet.getUrl());
}
